start = work-certificate

work-certificate = {
  "証明書名称" => text,
  "証明日" => tdate,
  
  ; 事業所情報 (Footer in Schema)
  "事業所名" => text,
  "代表者名" => text,
  "所在地" => text,
  "電話番号" => text,
  ? "担当者名" => text,
  ? "記載者連絡先" => text,

  ; 本人情報
  "本人氏名" => text,
  "フリガナ" => text,
  "生年月日" => tdate,

  ; 雇用条件
  "業種" => text,
  "雇用形態" => "無期" / "有期",
  ? "雇用期間開始" => tdate,
  ? "雇用期間終了" => tdate,
  "就労場所名称" => text,
  "就労場所住所" => text,
  ? "就労場所電話番号" => text,
  
  ; 就労時間・日数
  ? "就労時間合計" => text, ; e.g. "月160時間"
  ? "休憩時間" => text, ; e.g. "60分"
  ? "就労日数" => text, ; e.g. "週5日"
  ? "就労時間帯" => text, ; e.g. "9:00-18:00"

  ; 就労実績 (直近3ヶ月等)
  ? "就労実績" => [+ work-history-item],

  ; 休暇・制度利用状況
  ? "産休期間" => text, ; 期間文字列
  ? "育休期間" => text, ; 期間文字列
  ? "復職予定日" => tdate,
  ? "短時間勤務制度" => "有" / "無" / "有（予定）",
  ? "短時間勤務期間" => text,

  ; その他
  ? "保育士実態" => "有" / "無" / "有（予定）",
  ? "契約更新有無" => "有" / "無" / "未定",
  ? "入所内定時育休短縮可否" => "可" / "否" / "可（予定）",
  ? "単身赴任期間" => text,
  ? "備考" => text
}

work-history-item = {
  "年月" => text,
  "日数" => uint,
  "時間数" => uint
}
