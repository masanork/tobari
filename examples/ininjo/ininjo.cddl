; JPKI/e-Gov style Electronic Power of Attorney (PoC)
; Ported conceptually from typical XML Schemas for Delegation

ininjo = {
  "docType": "io.github.masanork.tobari.ininjo",
  "version": "1.0",
  "issuer": tstr,             ; e.g. "Self-Issued"
  "issuanceDate": tdate,

  ; 委任状本体 (Main Body)
  ; Header
  "id": tstr,                ; 委任状ID
  "creationTime": tdate,     ; 作成日時

  ; Mandator (委任者)
  "mandator": entity_obj,

  ; Mandatary (受任者)
  "mandatary": entity_obj,

  ; Delegated Authority (委任権限)
  "delegatedAuthority": {
      "validityPeriod": {    ; 有効期間
          ? "startDate": tdate,
          ? "endDate": tdate
      },
      "delegatedActs": [+ act_obj], ; 委任行為のリスト（1つ以上）
      "subDelegation": {     ; 復代理
          "allocated": bool, ; 復代理権の有無（XML: Allocated）
          ? "restriction": tstr ; 制限事項
      }
  },

  ; Provider Information
  ? "provider": {
      "serviceName": tstr,
      "policyUrl": tstr,
      "revocationUrl": tstr
  }
}

; Entity Object (Used for Mandator and Mandatary)
entity_obj = {
    "type": "Individual" / "Corporation", ; 区分
    "name": tstr,            ; 氏名・名称
    "address": tstr,         ; 住所・所在地
    ? "kanaName": tstr,      ; カナ
    
    ; Individual specific
    ? "birthDate": tdate,    ; 生年月日
    ? "gender": tstr,        ; 性別
    ? "tradeName": tstr,     ; 屋号
    ? "identificationId": tstr, ; 識別ID
    
    ; Corporation specific
    ? "corporateNumber": tstr,    ; 法人番号
    ? "representativeTitle": tstr,; 代表者肩書
    ? "representativeName": tstr, ; 代表者氏名

    ; Additional info
    ? "contact": tstr,       ; 連絡先
    ? "department": tstr,    ; 所属部課
    ? "title": tstr          ; 職名
}

act_obj = {
    "actName": tstr,         ; 手続名称
    ? "actCode": tstr,       ; 手続コード
    ? "note": tstr           ; 備考
}
