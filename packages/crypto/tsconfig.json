{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "declaration": true,
        "outDir": "./dist",
        "allowImportingTsExtensions": false,
        "noEmit": false,
        "baseUrl": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "paths": {
             "@tobari/crypto-wasm/*": ["../crypto-wasm/src/*"]
        }
    },
    "include": [
        "src/**/*"
    ]
}