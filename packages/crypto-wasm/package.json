{
    "name": "@tobari/crypto-wasm",
    "version": "0.0.1",
    "type": "module",
    "files": [
        "pkg"
    ],
    "main": "./pkg/tobari_crypto_wasm.js",
    "types": "./pkg/tobari_crypto_wasm.d.ts",
    "scripts": {
        "build": "npm run build:core && npm run build:full",
        "build:core": "wasm-pack build --target web --out-dir pkg/core --out-name tobari_crypto_wasm_core -- --no-default-features",
        "build:full": "wasm-pack build --target web --out-dir pkg/full --out-name tobari_crypto_wasm_full -- --features pqc_dsa",
        "test": "cargo test"
    },
    "devDependencies": {
        "wasm-pack": "^0.12.0",
        "typescript": "^5.0.0"
    }
}